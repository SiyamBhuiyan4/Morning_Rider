# ==============================================================================
# Morning Rider — Environment Configuration Example
# ==============================================================================
#
# CONNECTING TO YOUR NEW CONVEX DEPLOYMENT:
# ------------------------------------------------------------------------------
# 1. Login to your Convex account:
#      npx convex login
#
# 2. Link or create a new Convex project for local development:
#      npx convex dev
#    (This will automatically configure your project and write VITE_CONVEX_URL
#     and CONVEX_DEPLOYMENT into .env.local).
#
# 3. For Production deployment:
#      npx convex deploy
#    Take the deployed Convex URL (e.g. https://<deployment-name>.convex.cloud)
#    and set VITE_CONVEX_URL in your hosting platform (e.g. Vercel) environment variables.
# ==============================================================================

# Convex Deployment URL (Frontend Client)
# Auto-populated in .env.local by `npx convex dev` or manually set:
VITE_CONVEX_URL=https://<your-deployment-name>.convex.cloud

# Convex Deployment Identifier (Used by Convex CLI)
# CONVEX_DEPLOYMENT=dev:<your-deployment-name>

# Portal Selector: 'main' (for public, merchant, and rider site) or 'admin' (for admin panel)
VITE_PORTAL=main

# App Title & SEO Meta Tags
VITE_TITLE=Morning Rider — Courier Service
VITE_ROBOTS=index,follow

# ------------------------------------------------------------------------------
# Telegram CDN (Merchant Document Verification Storage)
# ------------------------------------------------------------------------------
# Files uploaded during merchant verification (NID, Trade License, TIN) are stored
# on Telegram CDN via Telegram Bot API. Built-in defaults are configured in code,
# but you can override them here if using your own Telegram bot and channel.
#
# VITE_TELEGRAM_BOT_TOKEN=8819171458:AAHd3_pjEj2tEYfuB1zgJkznnSqPsisB6p0
# VITE_TELEGRAM_CHAT_ID=-1004253971473

# ------------------------------------------------------------------------------
# Backend Convex Environment Variables (Optional - Set via Convex CLI)
# ------------------------------------------------------------------------------
# Used by convex/mailer.ts for sending email notifications:
#   npx convex env set GMAIL_USER your-email@gmail.com [--prod]
#   npx convex env set GMAIL_APP_PASSWORD <16-letter-app-password> [--prod]
#   npx convex env set SITE_URL https://morning-rider.vercel.app [--prod]
